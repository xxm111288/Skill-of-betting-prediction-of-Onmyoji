{
  "_schema": {
    "说明": "对弈竞猜阵容输入文件。复制本文件后逐字段替换为界面上的真实数值。/ 所有数值均取【界面显示的对弈面板】口径（见知识库 01 §2.4 口径C）。",
    "顶层字段": {
      "max_unit_turns": "模拟上限（单位回合数）。默认 600。",
      "arbiter_period": "裁决鬼王每多少个单位回合行动 1 次。默认 5（= 每轮 5 个式神各动一次）。数值越小 → 裁决之力叠得越快 → 越不利于纯奶/纯肉。",
      "teams.red / teams.blue": "双方。每方 units 数组。"
    },
    "unit字段": {
      "name": "式神名（用于识别座敷童子等特殊先机）。",
      "pos": "1..5，界面给出的『阵容序号』。群攻顺序按 4→1→2→3→5 用它排序。必填，否则退化为按输入顺序。",
      "role": "dps / control / support / healer / tank / fire / speed，仅用于报告分组。",
      "atk / hp / def": "界面上的攻击 / 生命 / 防御。",
      "spd": "界面上的速度。",
      "crit": "界面上的暴击（百分数，如 85 表示 85%）。⚠️ <100 会被 preflight 警告『未满暴』。",
      "cdmg": "界面上的暴击伤害（百分数，如 311 表示 311%）。",
      "hit / res": "界面上的效果命中 / 效果抵抗（百分数）。",
      "souls": "御魂套装名数组，如 [\"破势\",\"荒骷髅\"]。脚本内置效果表；首领御魂会被自动忽略并告警。",
      "passive": {
        "revive": "免死/复活次数（如石长姬 = 3）。",
        "no_heal": "true = 无法被治疗（如百羽凤凰火）。",
        "reduce": "常驻减伤，0.3 = 减伤 30%。",
        "start_shield_pct": "开局护盾占自身最大生命比例。",
        "dmg_mult": "技能/被动的常驻增伤倍率，1.8 = +80%。",
        "on_death": "（预留）阵亡时触发的效果描述。"
      },
      "basic": "{name,cost,coef,hits,aoe,cd} —— 普攻，兜底用。",
      "⭐被动/机制文案（R9 新增，强烈建议填）": {
        "skills[].desc": "技能文案原文（可含 Lv 说明）。★ 凡是【只有文字、没有数值参数】的被动，必须写进 desc，否则会被静默忽略。填了之后脚本会自动报 [被动未建模] / [机制未建模]。",
        "passive_desc / mechanics / notes": "放在 unit 顶层的补充说明文本，同样会被扫描告警。",
        "说明": "模拟器只读 coef/hits/aoe/cd 等结构化参数。『唯一效果』『先机』『回合开始时』类被动、以及时之隙/玄血/布都御魂等特殊机制，都只能靠 desc 让脚本识别并提醒。"
      },
      "skills": [
        {
          "name": "技能名",
          "cost": "鬼火消耗",
          "coef": "★完整技能系数（598% → 5.98；268% → 2.68）。含义是技能说明里的那个百分比，不要乘段数。",
          "main_coef": "可选：主目标系数，仅对第一个目标生效（如石长姬大招 598% 写这里、268% 写 coef）",
          "hits": "段数（技能说明里的『N 次』）。控制概率会按 1-(1-p)^N 叠加。",
          "aoe": "true = 群攻（按 4→1→2→3→5 选目标，命中全部存活敌方）",
          "cd": "冷却（单位回合）",
          "heal_pct": "可选：治疗，按施法者最大生命比例（0.15 = 15%）",
          "shield_pct": "可选：护盾，按施法者最大生命比例",
          "shield_scope": "可选（仅当 shield_pct 存在时生效）：默认 = 己方全体存活单位各得一份护盾。填 \"self_plus_top2_cdmg\" 则改为【自身 + 暴击伤害最高的 2 位友方】各得一份（用于复刻雪女「冰甲术」这类只覆盖 3 人的护盾）。⚠️ 不填时一律按全队处理，会把 3 人盾误算成 5 人盾、高估防御方。",
          "when": "always | ally_hp_below | ally_hp_above | enemy_has_control | self_hp_below —— 复刻知识库 06 §7.2 的 AI 判定条件",
          "thr": "when 的阈值",
          "control": {"type": "冰冻/眩晕/变形/沉默/沉睡/混乱/嘲讽/挑衅", "p": "基础概率小数", "turns": "持续回合", "single_roll": "true = 不按多段叠加（默认按 1-(1-p)^n）"}
        }
      ]
    },
    "已建模的御魂": ["阴摩罗","蝠翼","狰","轮入道","心眼","鸣屋","狂骨","兵主部","片叶之苇","破势","针女","网切","三味","伤魂鸟","镇墓兽","无刀取","被服","地藏像","涅槃之火","镜姬","钟灵","树妖","薙魂","夜啼石","叠叩","共潜","恶楼","涂佛","出世螺","奉海图","火之车","魅妖","雪幽魂","招财猫","反枕","日女巳时","珍珠","木魅","蚌精","火灵","遗念火","油赤子","贝吹坊","魍魉之匣","骰子鬼","幽谷响","返魂香","夜送犬","钓瓶火"],
    "在名单内但机制未建模": ["元兴寺","应声虫","飞缘魔","青女房","隐念","雨降","贝吹坊（贝甲挡伤）","尘冢（人数差）","兵主部（层数节奏）"],
    "⭐特殊机制（模拟器不建模，填了会告警，需人工在报告定性补充）": {
      "时之隙 / 时之缝 / 时之辉 / 时寂之刻": "卑弥呼(583) / 时曜泷夜叉姬(584) / 荒骷髅(585) / 平将门(592)。见 04 §12.1。",
      "玄血 / 形毁伤害": "龙珏(573)。见 04 §12.2。",
      "布都御魂": "平将门(592)。见 04 §12.3。",
      "伤害类型（直接/间接/真实/固定）": "见 04 §7。真实伤害与固定伤害均『无视防御』但不完全相同。"
    },
    "对弈无效的御魂（会被忽略并告警）": ["荒骷髅","土蜘蛛","胧车","地震鲶","蜃气楼","鬼灵歌伎","夜荒魂","八咫镜","天羽羽斩","预言星盘","月之石","纺缘锤","稻荷穗箭"],
    "名单外的御魂名（会被判为拼写错误）": ["凶骨","森罗","神乐铃","净火"],
    "注": "「对弈无效」里的后 6 件（原星痕御魂）自 2026-04-15 起已被官方调整为首领御魂、不再支持斗技/结界突破/道馆 → 对弈同样不生效。见 05_御魂与套装.md §2.7b。",
    "警告": "本文件中的数值是【示例占位】，不是真实面板。实盘请逐项替换为界面上看到的数字。"
  },

